# ── Formspree ──────────────────────────────────────────────────────────────────
# The contact form submits directly to Formspree.
# The destination email (orders@yuccabekidding.com) is configured in the
# Formspree dashboard — no environment variable needed for basic usage.
#
# If you create a named form in the Formspree dashboard and want to use
# its hash ID instead of the email address, update the useForm() call in
# components/Contact.tsx:
#
#   const [state, handleSubmit] = useForm("YOUR_FORM_HASH_ID")
#
# Dashboard: https://formspree.io/forms

# ── Resend (not currently used — kept for reference) ───────────────────────────
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
